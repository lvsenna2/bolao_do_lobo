rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isFixedAdmin() {
      return signedIn() && request.auth.token.email == "lvaz@id.uff.br";
    }

    match /v12_users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isFixedAdmin());
      allow delete: if isFixedAdmin();
    }

    match /v12_games/{gameId} {
      allow read: if signedIn();
      allow write: if isFixedAdmin();
    }

    match /v12_predictions/{predictionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isFixedAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isFixedAdmin();
    }

    match /v12_settings/{docId} {
      allow read: if signedIn();
      allow write: if isFixedAdmin();
    }
  }
}
